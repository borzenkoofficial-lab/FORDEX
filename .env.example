# Copy into your hosting environment; never commit real secrets.
# Generate a unique secret with at least 32 characters.
FORDEX_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Set the final public origin before production build to generate sitemap/canonical URLs.
SITE_URL=https://your-domain.example

# Configure only the provider you plan to use.
ANYMODEL_API_KEY=
OPENAI_API_KEY=

# Optional model routing.
FORDEX_AI_PROVIDER=anymodel
FORDEX_ANYMODEL_BASE_URL=https://anymodel.org/v1
FORDEX_ANYMODEL_MODEL=gpt-5.6-luna
FORDEX_ASTRA_BASE_URL=https://api.openai.com/v1
FORDEX_ASTRA_MODEL=gpt-6-astra
